# Database & Payload
DATABASE_URL=postgresql://postgres:lawrence_dev_password@localhost:5432/lawrence
PAYLOAD_SECRET=dev_secret_change_me_in_production_min_32_chars

# Application URL & Localisation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Cloudflare R2 / Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lawrence-media
NEXT_PUBLIC_CF_IMAGES_URL=https://images.lawrenceprivatecollection.com

# Map Services
NEXT_PUBLIC_MAPTILER_KEY=dev_maptiler_key

# Search Engine (Typesense)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=devkey
TYPESENSE_SEARCH_ONLY_KEY=devkey_search
# Scoped per-collection search keys (pnpm search:keys). The member key is server-side ONLY.
TYPESENSE_PUBLIC_SEARCH_KEY=
TYPESENSE_MEMBER_SEARCH_KEY=

# Email & Notifications
RESEND_API_KEY=re_dev_key
LEAD_NOTIFY_TO=leads@lawrenceprivatecollection.com
AGENCY_NOTIFY_FROM=noreply@lawrenceprivatecollection.com

# External APIs
FX_API_URL=https://api.frankfurter.app
UNSPLASH_ACCESS_KEY=dev_unsplash_key

# Revalidation & Cron Secrets
REVALIDATE_SECRET=dev_revalidate_secret_key
CRON_SECRET=dev_cron_secret_key
FEED_INGEST_SECRET=dev_feed_ingest_secret

# Feature Flags & Analytics
SAMPLE_DATA_ENABLED=true
MEMBER_REQUIRE_APPROVAL=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lawrenceprivatecollection.com
SENTRY_DSN=
