    "audit:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm audit:seo && pnpm audit:a11y && pnpm audit:exposure",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "build:deploy": "payload migrate && pnpm build",
